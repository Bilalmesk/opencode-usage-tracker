{
  "name": "opencode-usage-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only dashboard for OpenCode free, Go, Zen, and external-provider usage.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "open": "node server.mjs --open",
